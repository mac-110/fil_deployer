# FIL Deployer Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SECURITY - Encryption Secret
# =============================================================================
# Secret used for encrypting tokens in app_config.json
# IMPORTANT: Change this to a strong, random secret in production!
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your-super-secret-encryption-key-change-this-in-production

# =============================================================================
# APPLICATION
# =============================================================================
# Session secret for cookie signing
SESSION_SECRET=change-me-in-production

# Backend URL (used by frontend)
BACKEND_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# GITLAB (Optional - can be configured via UI in Settings)
# =============================================================================
# GitLab instance URL
# GITLAB_URL=https://code.swisscom.com

# GitLab Group Access Token (with api scope)
# GITLAB_GROUP_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# ARTIFACTORY (Optional - can be configured via UI in Settings)
# =============================================================================
# Artifactory URL
# ARTIFACTORY_URL=https://bin.swisscom.com

# Artifactory API Token
# ARTIFACTORY_TOKEN=AKCp8xxxxxxxxxxxxxxxxx

# =============================================================================
# CONFIGURATION
# =============================================================================
# Path to customer configuration file
CONFIG_FILE=config/customers.json

# Git clone cache directory
GIT_CACHE_DIR=/tmp/fil-deployer-repos

# =============================================================================
# DOCKER-SPECIFIC
# =============================================================================
# Only needed when running with Docker

# Host port for backend (default: 8000)
# BACKEND_PORT=8000

# Host port for frontend (default: 3000)
# FRONTEND_PORT=3000
